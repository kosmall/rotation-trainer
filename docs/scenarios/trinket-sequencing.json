  "script": {
    "rules": [
      {
        "action": "use",
        "id": "item:281735",
        "if": "heroism.active && target.aura.shadow-vulnerability.active",
        "label": "Pipe in the burst",
        "comment": "Trinket 1: only with Heroism and Improved Shadow Bolt (shadow-vulnerability) on the target."
      },
      {
        "action": "use",
        "id": "item:29370",
        "if": "use.item:281735.count >= 1",
        "label": "Icon after the Pipe",
        "comment": "Trinket 2: once the Pipe has been used (the shared 20 s trinket cooldown delays it anyway)."
      },
      {
        "action": "cast",
        "id": "curse-of-the-elements",
        "if": "!target.aura.curse-of-the-elements.active",
        "label": "Curse of the Elements"
      },
      {
        "action": "cast",
        "id": "shadowburn",
        "if": "time.remaining <= finisherWindow()",
        "label": "Shadowburn (finisher)",
        "comment": "A Shadow Bolt started now would land after the end: finish with instant Shadowburn."
      },
      {
        "action": "cast",
        "id": "immolate",
        "if": "dotRefreshDue(immolate)",
        "label": "Immolate"
      },
      {
        "action": "cast",
        "id": "corruption",
        "if": "dotRefreshDue(corruption)",
        "label": "Corruption"
      },
      {
        "action": "cast",
        "id": "life-tap",
        "if": "mana < manaCost(shadow-bolt)",
        "label": "Life Tap"
      },
      {
        "action": "cast",
        "id": "shadow-bolt",
        "label": "Shadow Bolt"
      }
    ]
  },
  "notes": "Both trinkets are worn but not enabled in setup.enabledBuffs: a script may use any worn on-use item (enabledBuffs only switches the basic rotation's automatic use)."
